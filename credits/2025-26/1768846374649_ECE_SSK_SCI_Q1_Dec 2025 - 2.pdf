                  pdfaProperty:name="PlateNames"
                  pdfaProperty:valueType="Seq Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
